---
const properties = [
	{
		name: "Diamonds Thudufushi",
		location: "Maldives",
		brand: "Diamonds",
		type: "Water Villa Resort",
		description: "Intimate overwater paradise with pristine beaches and world-class diving",
		awards: ["Maldives' Leading Beach Resort 2025"]
	},
	{
		name: "Diamonds Athuruga",
		location: "Maldives",
		brand: "Diamonds",
		type: "Boutique Island Resort",
		description: "Exquisite intimate escape with personalized service and stunning house reef",
		awards: ["Tripadvisor Travelers' Choice 2024"]
	},
	{
		name: "Diamonds Mapenzi Beach",
		location: "Zanzibar",
		brand: "Diamonds",
		type: "Beach Resort",
		description: "Tropical paradise on Zanzibar's finest beach with all-inclusive luxury",
		awards: []
	},
	{
		name: "Diamonds Bijoux Beach",
		location: "Zanzibar",
		brand: "Diamonds",
		type: "Boutique Beach Resort",
		description: "Intimate boutique experience on Zanzibar's pristine coastline",
		awards: []
	},
	{
		name: "Diamonds Malindi",
		location: "Kenya",
		brand: "Diamonds",
		type: "All-Inclusive Resort",
		description: "Award-winning all-inclusive resort on Kenya's tropical coast",
		awards: ["Africa's Leading All-Inclusive Resort 2025"]
	},
	{
		name: "Diamonds Leisure Beach & Golf",
		location: "Diani Beach, Kenya",
		brand: "Diamonds",
		type: "Golf & Beach Resort",
		description: "Kenya's premier golf and beach destination with championship course",
		awards: ["Africa's Leading Resort 2025", "Kenya's Leading Resort 2025"]
	},
	{
		name: "Sandies Nungwi",
		location: "Zanzibar",
		brand: "Sandies",
		type: "Family Beach Resort",
		description: "Fun-filled family resort with activities for all ages on Zanzibar's north coast",
		awards: []
	},
	{
		name: "Exploreans Malaika",
		location: "Kenya",
		brand: "Exploreans",
		type: "Safari Lodge",
		description: "Intimate safari experience in Kenya's wildlife-rich landscapes",
		awards: []
	},
	{
		name: "Exploreans Mara River Camp",
		location: "Kenya",
		brand: "Exploreans",
		type: "Tented Safari Camp",
		description: "Authentic tented camp experience in the heart of Maasai Mara",
		awards: []
	},
	{
		name: "The View",
		location: "Lugano, Switzerland",
		brand: "Independent",
		type: "Design Hotel",
		description: "Contemporary design hotel with panoramic views and sustainable luxury",
		awards: ["Small Luxury Hotels of the World"]
	},
	{
		name: "Hotel Italia",
		location: "Cortona, Tuscany",
		brand: "Independent",
		type: "Boutique Hotel",
		description: "Charming boutique hotel in the heart of historic Cortona",
		awards: []
	}
];

const regions = ["All", "Maldives", "Zanzibar", "Kenya", "Europe"];
---

<section class="properties" id="properties">
	<div class="container">
		<div class="section-header">
			<span class="section-eyebrow">Our Collection</span>
			<h2 class="section-title">
				Eleven Exceptional 
				<span class="accent">Destinations</span>
			</h2>
			<p class="section-description">
				From overwater villas in the Maldives to safari camps in Kenya, 
				each property reflects our commitment to excellence and authentic experiences.
			</p>
		</div>

		<div class="region-filters">
			{regions.map(region => (
				<button class={`filter-btn ${region === "All" ? "active" : ""}`} data-region={region}>
					{region}
				</button>
			))}
		</div>

		<div class="properties-grid">
			{properties.map(property => (
				<article class="property-card" data-region={property.location.includes("Maldives") ? "Maldives" : property.location.includes("Zanzibar") ? "Zanzibar" : property.location.includes("Kenya") ? "Kenya" : "Europe"}>
					<div class="property-image">
						<div class={`placeholder ${property.brand.toLowerCase()}`}>
							<span class="brand-badge">{property.brand}</span>
						</div>
						{property.awards.length > 0 && (
							<div class="awards-badge">
								🏆 {property.awards.length} Award{property.awards.length > 1 ? 's' : ''}
							</div>
						)}
					</div>
					<div class="property-content">
						<div class="property-meta">
							<span class="location">📍 {property.location}</span>
							<span class="type">{property.type}</span>
						</div>
						<h3 class="property-name">{property.name}</h3>
						<p class="property-description">{property.description}</p>
						<div class="property-actions">
							<a href="#" class="btn-property">View Property</a>
							<a href="#" class="btn-book">Book Now</a>
						</div>
					</div>
				</article>
			))}
		</div>

		<div class="properties-cta">
			<p>Looking for management services for your property?</p>
			<a href="#contact" class="btn btn-primary">Discuss Partnership Opportunities</a>
		</div>
	</div>
</section>

<style>
	.properties {
		padding: var(--space-2xl) 0;
		background: var(--color-white);
	}

	.section-header {
		text-align: center;
		max-width: 700px;
		margin: 0 auto var(--space-xl);
	}

	.section-eyebrow {
		display: inline-block;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-accent);
		margin-bottom: var(--space-sm);
	}

	.section-title {
		font-size: clamp(2rem, 4vw, 3rem);
		color: var(--color-primary);
		margin-bottom: var(--space-sm);
	}

	.section-title .accent {
		color: var(--color-ocean);
		font-style: italic;
	}

	.section-description {
		font-size: 1.1rem;
		color: var(--color-text-light);
		line-height: 1.7;
	}

	.region-filters {
		display: flex;
		justify-content: center;
		gap: var(--space-xs);
		margin-bottom: var(--space-lg);
		flex-wrap: wrap;
	}

	.filter-btn {
		padding: 0.625rem 1.25rem;
		font-size: 0.9rem;
		font-weight: 500;
		background: transparent;
		border: 2px solid rgba(26, 26, 46, 0.1);
		border-radius: 30px;
		color: var(--color-text);
		transition: var(--transition-base);
	}

	.filter-btn:hover,
	.filter-btn.active {
		background: var(--color-primary);
		border-color: var(--color-primary);
		color: var(--color-white);
	}

	.properties-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-md);
		margin-bottom: var(--space-xl);
	}

	.property-card {
		background: var(--color-cream);
		border-radius: 16px;
		overflow: hidden;
		transition: var(--transition-base);
	}

	.property-card:hover {
		transform: translateY(-8px);
		box-shadow: 0 25px 50px rgba(26, 26, 46, 0.1);
	}

	.property-image {
		position: relative;
		height: 220px;
		overflow: hidden;
	}

	.placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: flex-end;
		justify-content: flex-start;
		padding: var(--space-sm);
	}

	.placeholder.diamonds {
		background: linear-gradient(135deg, #2c5f6f 0%, #1a4a5a 100%);
	}

	.placeholder.sandies {
		background: linear-gradient(135deg, #c9895d 0%, #a66d3f 100%);
	}

	.placeholder.exploreans {
		background: linear-gradient(135deg, #5a7d5a 0%, #3d5a3d 100%);
	}

	.placeholder.independent {
		background: linear-gradient(135deg, var(--color-secondary) 0%, var(--color-primary) 100%);
	}

	.brand-badge {
		background: rgba(255, 255, 255, 0.2);
		backdrop-filter: blur(10px);
		padding: 0.35rem 0.75rem;
		border-radius: 20px;
		color: var(--color-white);
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.awards-badge {
		position: absolute;
		top: var(--space-sm);
		right: var(--space-sm);
		background: var(--color-accent);
		color: var(--color-primary);
		padding: 0.35rem 0.75rem;
		border-radius: 20px;
		font-size: 0.75rem;
		font-weight: 600;
	}

	.property-content {
		padding: var(--space-md);
	}

	.property-meta {
		display: flex;
		gap: var(--space-xs);
		margin-bottom: 0.75rem;
		flex-wrap: wrap;
	}

	.location,
	.type {
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.type {
		background: rgba(26, 26, 46, 0.05);
		padding: 0.15rem 0.5rem;
		border-radius: 4px;
	}

	.property-name {
		font-size: 1.35rem;
		color: var(--color-primary);
		margin-bottom: 0.5rem;
	}

	.property-description {
		font-size: 0.9rem;
		color: var(--color-text-light);
		line-height: 1.6;
		margin-bottom: var(--space-sm);
	}

	.property-actions {
		display: flex;
		gap: 0.75rem;
	}

	.btn-property,
	.btn-book {
		flex: 1;
		padding: 0.625rem;
		font-size: 0.85rem;
		font-weight: 600;
		text-align: center;
		border-radius: 6px;
		transition: var(--transition-fast);
	}

	.btn-property {
		background: transparent;
		border: 2px solid var(--color-primary);
		color: var(--color-primary);
	}

	.btn-property:hover {
		background: var(--color-primary);
		color: var(--color-white);
	}

	.btn-book {
		background: var(--color-accent);
		color: var(--color-primary);
	}

	.btn-book:hover {
		background: var(--color-accent-light);
	}

	.properties-cta {
		text-align: center;
		padding: var(--space-lg);
		background: linear-gradient(135deg, var(--color-cream) 0%, var(--color-sand) 100%);
		border-radius: 16px;
	}

	.properties-cta p {
		font-size: 1.2rem;
		color: var(--color-primary);
		margin-bottom: var(--space-sm);
	}

	@media (max-width: 1024px) {
		.properties-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.properties-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
