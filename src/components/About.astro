---
import aboutData from '../content/sections/about.json';

const values = [
	{
		title: "Heritage & Trust",
		description: "Founded in Lugano in 1997, we've built lasting relationships through consistent excellence and family-oriented values.",
		icon: "🏛️"
	},
	{
		title: "Innovation First",
		description: "We embrace new technologies and sustainable practices to stay ahead in an ever-evolving hospitality landscape.",
		icon: "💡"
	},
	{
		title: "Environmental Harmony",
		description: "Our commitment to 'saving our planet' drives every decision, from towel conservation to community support programs.",
		icon: "🌿"
	},
	{
		title: "Employee Ownership",
		description: "We foster a sense of ownership among our team, creating the 'home away from home' experience our guests cherish.",
		icon: "🤝"
	}
];
---

<section class="about" id="about">
	<div class="container">
		<div class="about-grid">
			<div class="about-content">
				<span class="section-eyebrow">Our Story</span>
				<h2 class="section-title">
					A Quarter Century of 
					<span class="accent">Hospitality Excellence</span>
				</h2>
				<div class="about-text">
					<p>
						What began in 1997 with Tropical Village in Malindi, Kenya, has evolved into 
						a distinguished hospitality group spanning five countries. Our journey from a 
						single property to 11 extraordinary destinations reflects our unwavering commitment 
						to professional management and authentic guest experiences.
					</p>
					<p>
						Today, Planhotel stands as a wise and passionate leader in the industry, 
						delivering above-average returns for owners while creating memorable moments 
						for travelers seeking the extraordinary.
					</p>
				</div>
				<div class="about-mission">
					<blockquote>
						"To achieve above average returns for our owners through professional management, 
						positive communication and interaction with our guests, our employees and 
						business partners by continuously emphasizing our brand and values."
					</blockquote>
					<cite>— Our Mission</cite>
				</div>
			</div>
			<div class="about-visual">
				<div class="image-grid">
					{aboutData.images.map((img, index) => (
						<div class={`image-item ${index === 0 ? 'large' : ''}`}>
							<img src={img.image} alt={img.alt} loading="lazy" />
						</div>
					))}
				</div>
			</div>
		</div>

		<div class="values-section">
			<h3 class="values-title">Our Core Values</h3>
			<div class="values-grid">
				{values.map(value => (
					<div class="value-card">
						<span class="value-icon">{value.icon}</span>
						<h4>{value.title}</h4>
						<p>{value.description}</p>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.about {
		padding: var(--space-2xl) 0;
		background: var(--color-white);
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-xl);
		align-items: start;
	}

	.section-eyebrow {
		display: inline-block;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-accent);
		margin-bottom: var(--space-sm);
	}

	.section-title {
		font-size: clamp(2rem, 4vw, 3rem);
		color: var(--color-primary);
		margin-bottom: var(--space-md);
		line-height: 1.2;
	}

	.section-title .accent {
		color: var(--color-ocean);
		font-style: italic;
	}

	.about-text {
		margin-bottom: var(--space-lg);
	}

	.about-text p {
		font-size: 1.1rem;
		line-height: 1.8;
		color: var(--color-text-light);
		margin-bottom: var(--space-sm);
	}

	.about-mission {
		background: var(--color-cream);
		padding: var(--space-md);
		border-radius: 12px;
		border-left: 4px solid var(--color-accent);
	}

	.about-mission blockquote {
		font-family: var(--font-heading);
		font-size: 1.15rem;
		font-style: italic;
		color: var(--color-primary);
		line-height: 1.6;
		margin-bottom: var(--space-xs);
	}

	.about-mission cite {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-accent);
		font-style: normal;
	}

	.about-visual {
		position: sticky;
		top: 120px;
	}

	.image-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-sm);
	}

	.image-item {
		aspect-ratio: 1;
		border-radius: 12px;
		overflow: hidden;
	}

	.image-item.large {
		grid-column: span 2;
		aspect-ratio: 16/9;
	}

	.image-item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 12px;
	}

	.values-section {
		margin-top: var(--space-2xl);
		padding-top: var(--space-xl);
		border-top: 1px solid rgba(26, 26, 46, 0.08);
	}

	.values-title {
		font-size: 2rem;
		text-align: center;
		color: var(--color-primary);
		margin-bottom: var(--space-lg);
	}

	.values-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: var(--space-md);
	}

	.value-card {
		background: var(--color-cream);
		padding: var(--space-md);
		border-radius: 16px;
		text-align: center;
		transition: var(--transition-base);
	}

	.value-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 20px 40px rgba(26, 26, 46, 0.08);
	}

	.value-icon {
		font-size: 2.5rem;
		display: block;
		margin-bottom: var(--space-sm);
	}

	.value-card h4 {
		font-size: 1.1rem;
		color: var(--color-primary);
		margin-bottom: 0.5rem;
	}

	.value-card p {
		font-size: 0.9rem;
		color: var(--color-text-light);
		line-height: 1.6;
	}

	@media (max-width: 1024px) {
		.about-grid {
			grid-template-columns: 1fr;
		}

		.about-visual {
			position: relative;
			top: 0;
			order: -1;
		}

		.values-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.values-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
