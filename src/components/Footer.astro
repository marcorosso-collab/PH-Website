---
const currentYear = new Date().getFullYear();

const footerLinks = {
	company: [
		{ label: "About Us", href: "#about" },
		{ label: "Our Brands", href: "#brands" },
		{ label: "Properties", href: "#properties" },
		{ label: "Services", href: "#services" }
	],
	brands: [
		{ label: "Diamonds Resorts", href: "#" },
		{ label: "Sandies Resorts", href: "#" },
		{ label: "Exploreans Lodges", href: "#" },
		{ label: "The View Lugano", href: "#" }
	],
	resources: [
		{ label: "Press & Media", href: "#" },
		{ label: "Careers", href: "#" },
		{ label: "Sustainability", href: "#" },
		{ label: "Partner Login", href: "#" }
	],
	legal: [
		{ label: "Privacy Policy", href: "#" },
		{ label: "Terms of Service", href: "#" },
		{ label: "Cookie Policy", href: "#" }
	]
};
---

<footer class="footer">
	<div class="container">
		<div class="footer-grid">
			<div class="footer-brand">
				<div class="logo">
					<span class="logo-text">Planhotel</span>
					<span class="logo-subtitle">Hospitality Group</span>
				</div>
				<p class="footer-tagline">
					Enjoy Real Hospitality. Professional hotel management 
					and development since 1997.
				</p>
				<div class="social-links">
					<a href="#" class="social-link" aria-label="LinkedIn">
						<svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
					</a>
					<a href="#" class="social-link" aria-label="Instagram">
						<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
					</a>
					<a href="#" class="social-link" aria-label="Facebook">
						<svg viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
					</a>
				</div>
			</div>

			<div class="footer-links">
				<h4>Company</h4>
				<ul>
					{footerLinks.company.map(link => (
						<li><a href={link.href}>{link.label}</a></li>
					))}
				</ul>
			</div>

			<div class="footer-links">
				<h4>Our Brands</h4>
				<ul>
					{footerLinks.brands.map(link => (
						<li><a href={link.href}>{link.label}</a></li>
					))}
				</ul>
			</div>

			<div class="footer-links">
				<h4>Resources</h4>
				<ul>
					{footerLinks.resources.map(link => (
						<li><a href={link.href}>{link.label}</a></li>
					))}
				</ul>
			</div>
		</div>

		<div class="footer-bottom">
			<div class="footer-legal">
				{footerLinks.legal.map((link, index) => (
					<>
						<a href={link.href}>{link.label}</a>
						{index < footerLinks.legal.length - 1 && <span class="separator">•</span>}
					</>
				))}
			</div>
			<p class="copyright">
				© {currentYear} Planhotel Hospitality Group. All rights reserved.
			</p>
		</div>
	</div>
</footer>

<style>
	.footer {
		background: var(--color-primary);
		color: var(--color-white);
		padding: var(--space-xl) 0 var(--space-md);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr 1fr;
		gap: var(--space-lg);
		margin-bottom: var(--space-lg);
		padding-bottom: var(--space-lg);
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	.footer-brand .logo {
		display: flex;
		flex-direction: column;
		margin-bottom: var(--space-sm);
	}

	.footer-brand .logo-text {
		font-family: var(--font-heading);
		font-size: 1.75rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1;
	}

	.footer-brand .logo-subtitle {
		font-size: 0.65rem;
		font-weight: 500;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		opacity: 0.7;
	}

	.footer-tagline {
		font-size: 0.95rem;
		line-height: 1.7;
		opacity: 0.8;
		margin-bottom: var(--space-md);
		max-width: 300px;
	}

	.social-links {
		display: flex;
		gap: var(--space-xs);
	}

	.social-link {
		width: 40px;
		height: 40px;
		background: rgba(255, 255, 255, 0.1);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: var(--transition-fast);
	}

	.social-link:hover {
		background: var(--color-accent);
		transform: translateY(-3px);
	}

	.social-link svg {
		width: 18px;
		height: 18px;
	}

	.footer-links h4 {
		font-size: 0.9rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-bottom: var(--space-sm);
		opacity: 0.9;
	}

	.footer-links ul {
		list-style: none;
	}

	.footer-links li {
		margin-bottom: 0.75rem;
	}

	.footer-links a {
		font-size: 0.9rem;
		opacity: 0.7;
		transition: var(--transition-fast);
	}

	.footer-links a:hover {
		opacity: 1;
		color: var(--color-accent);
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-sm);
	}

	.footer-legal {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.footer-legal a {
		font-size: 0.85rem;
		opacity: 0.7;
		transition: var(--transition-fast);
	}

	.footer-legal a:hover {
		opacity: 1;
		color: var(--color-accent);
	}

	.separator {
		opacity: 0.4;
	}

	.copyright {
		font-size: 0.85rem;
		opacity: 0.6;
	}

	@media (max-width: 1024px) {
		.footer-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.footer-grid {
			grid-template-columns: 1fr;
			gap: var(--space-md);
		}

		.footer-bottom {
			flex-direction: column;
			text-align: center;
		}

		.footer-legal {
			flex-wrap: wrap;
			justify-content: center;
		}
	}
</style>
