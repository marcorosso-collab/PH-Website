---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Brands from '../components/Brands.astro';
import Properties from '../components/Properties.astro';
import Services from '../components/Services.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import heroData from '../content/sections/hero.json';
---

<Layout 
	title="Professional Hotel Management & Luxury Resorts"
	description="Planhotel Hospitality Group: 25+ years managing luxury resorts in Maldives, Zanzibar, Kenya & Europe. Professional hotel management, development & consultancy services."
	image={heroData.image}
>
	<Header />
	<main>
		<Hero />
		<About />
		<Brands />
		<Properties />
		<Services />
		<Contact />
	</main>
	<Footer />
</Layout>

<style>
	main {
		padding-top: 80px;
	}
</style>
